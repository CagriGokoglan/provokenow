APP_NAME="Provoke Now"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=provokenow
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Default superadmin (database/seeders/AdminUserSeeder.php).
# Leave ADMIN_PASSWORD empty to generate a random one at seed time.
ADMIN_NAME="Provoke Now Admin"
ADMIN_EMAIL=admin@provokenow.com
ADMIN_PASSWORD=

# Commerce (config/provoke.php)
STORE_CURRENCY=USD
TAX_RATE_BPS=0
SHIPPING_FLAT_CENTS=995
FREE_SHIPPING_THRESHOLD_CENTS=15000
VAULT_UNLOCK_TTL_MINUTES=15
# Non-production only (ignored when APP_ENV=production):
#  - exposes POST /api/v1/orders/fulfill-test (staff only)
#  - while STRIPE_SECRET_KEY is empty, checkout uses the TEST MODE payment page instead of Stripe
ENABLE_TEST_FULFILLMENT=false

# Public site (Next.js) — canonical, sitemap and email links point here
FRONTEND_URL=https://provokenow.com
BRAND_LOGO_URL=https://provokenow.com/brand/logo.png
# Comma-separated official profile URLs (Instagram, TikTok, ...) for Organization.sameAs
BRAND_SAME_AS=
SEO_DEFAULT_OG_IMAGE=https://provokenow.com/og/default.jpg

# Public tracking IDs (exposed via GET /api/v1/config/public)
META_PIXEL_ID=
GTM_CONTAINER_ID=
GOOGLE_SITE_VERIFICATION=

# Meta Conversions API (secret — server only)
META_CAPI_ACCESS_TOKEN=
META_GRAPH_VERSION=v19.0
META_CAPI_TEST_EVENT_CODE=

# Brevo transactional email (secret — server only)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=orders@provokenow.com
BREVO_SENDER_NAME="PROVOKE NOW"
BREVO_REPLY_TO=care@provokenow.com
BREVO_TEMPLATE_ORDER_CONFIRMATION=
BREVO_TEMPLATE_SHIPPING_UPDATE=

# Stripe Checkout (secret — server only). Webhook endpoint: POST {APP_URL}/api/v1/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired, charge.refunded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SHIPPING_COUNTRIES=US
STRIPE_SESSION_TTL_MINUTES=30
