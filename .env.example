APP_NAME="Provoke Now"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=provokenow
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Account emails (verification, password reset) go through Laravel's mailer.
# Recommended: MAIL_MAILER=brevo — Brevo's HTTP API with the BREVO_API_KEY below (no SMTP needed).
# Alternative: MAIL_MAILER=smtp with Brevo SMTP (Brevo → SMTP & API → SMTP tab: login + SMTP key).
# Local development: MAIL_MAILER=log writes emails to storage/logs/laravel.log.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
# The sender domain must be verified in Brevo (Senders, Domains & Dedicated IPs).
MAIL_FROM_ADDRESS=noreply@provokenow.com
MAIL_FROM_NAME="PROVOKE NOW"
# Minutes an email verification link stays valid (default 24 h).
EMAIL_VERIFICATION_EXPIRE=1440

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Default superadmin (database/seeders/AdminUserSeeder.php).
# Leave ADMIN_PASSWORD empty to generate a random one at seed time.
ADMIN_NAME="Provoke Now Admin"
ADMIN_EMAIL=admin@provokenow.com
ADMIN_PASSWORD=

# Commerce (config/provoke.php)
STORE_CURRENCY=USD
TAX_RATE_BPS=0
VAULT_UNLOCK_TTL_MINUTES=15
# Non-production only (ignored when APP_ENV=production):
#  - exposes POST /api/v1/orders/fulfill-test (staff only)
#  - while STRIPE_SECRET_KEY is empty, checkout uses the TEST MODE payment page instead of Stripe
ENABLE_TEST_FULFILLMENT=false

# Public site (Next.js) — canonical, sitemap and email links point here
FRONTEND_URL=https://provokenow.com
# Admin edits refresh the web app instantly. Same random value as REVALIDATE_SECRET on the web app.
FRONTEND_REVALIDATE_URL=http://127.0.0.1:3100/revalidate
FRONTEND_REVALIDATE_SECRET=
BRAND_LOGO_URL=https://provokenow.com/brand/logo.png
# Comma-separated official profile URLs (Instagram, TikTok, ...) for Organization.sameAs
BRAND_SAME_AS=
SEO_DEFAULT_OG_IMAGE=https://provokenow.com/og/default.png

# Public tracking IDs (exposed via GET /api/v1/config/public)
META_PIXEL_ID=
GTM_CONTAINER_ID=
# Google Analytics 4 (default G-0RRFRJNEYD); loaded only after cookie consent.
GA4_MEASUREMENT_ID=G-0RRFRJNEYD
GOOGLE_SITE_VERIFICATION=

# Meta Conversions API (secret — server only)
META_CAPI_ACCESS_TOKEN=
META_GRAPH_VERSION=v19.0
META_CAPI_TEST_EVENT_CODE=

# Brevo transactional email (secret — server only)
BREVO_API_KEY=
BREVO_SENDER_EMAIL=orders@provokenow.com
BREVO_SENDER_NAME="PROVOKE NOW"
BREVO_REPLY_TO=care@provokenow.com

# Legal pages + contact form (/legal/contact). Messages go to CONTACT_TO (default SUPPORT_EMAIL).
COMPANY_NAME="GKLN ENTERPRISES LLC"
COMPANY_BILLING_DESCRIPTOR="GKLN ENTERPRISES LLC"
SUPPORT_EMAIL=support@provokenow.com
CONTACT_TO=
# Optional Cloudflare Turnstile on the contact form (both keys, or leave empty).
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Stripe Checkout (secret — server only). Webhook endpoint: POST {APP_URL}/api/v1/webhooks/stripe
# Events: checkout.session.completed, checkout.session.async_payment_succeeded,
#         checkout.session.async_payment_failed, checkout.session.expired, charge.refunded
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_SHIPPING_COUNTRIES=US
STRIPE_SESSION_TTL_MINUTES=30

# Admin image uploads are re-encoded to WebP in the queue (php artisan provoke:optimize-images for existing files)
IMAGE_QUALITY=82
IMAGE_MAX_DIMENSION=2400

# Staff must sign in to the admin with an authenticator-app code (Security page). Lost device:
# php artisan admin:reset-2fa you@example.com
ADMIN_REQUIRE_2FA=true
# Inbox for "Lost access to device?" sign-in codes (empty = each admin account's own email).
ADMIN_2FA_EMAIL=
# Extra proxies allowed to pass the visitor IP (this server and loopback are always trusted).
TRUSTED_PROXIES=
